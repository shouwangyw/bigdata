<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:dubbo="http://code.alibabatech.com/schema/dubbo"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://code.alibabatech.com/schema/dubbo http://code.alibabatech.com/schema/dubbo/dubbo.xsd">

  <dubbo:application name="recommend-consumer"/>

  <!-- 向 zookeeper 订阅 provider 的地址，由 zookeeper 定时推送 -->
  <dubbo:registry address="zookeeper://node3:2181"/>
  <dubbo:registry address="zookeeper://node4:2181"/>
  <dubbo:registry address="zookeeper://node5:2181"/>

  <dubbo:reference id="rcmdService" interface="com.yw.recommend.service.RcmdService" timeout="1200000"/>
  <dubbo:reference id="demoService" interface="com.yw.recommend.service.DemoService" timeout="1200000"/>
  <dubbo:reference id="programRcmdService" interface="com.yw.recommend.service.ProgramRcmdService" timeout="1200000"/>
</beans>